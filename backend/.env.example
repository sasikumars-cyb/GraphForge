# Copy to .env and adjust for your environment. Never commit the real .env.

APP_NAME=GraphForge
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://graphforge:graphforge@localhost:5432/graphforge
DATABASE_ECHO=false

# --- Auth (JWT) ---
# The default below is fine for local dev only - any real deployment MUST
# override this with a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Token encryption (GitHub access tokens at rest) ---
# The default below is a real Fernet key but it's public (checked into this
# repo) - any real deployment MUST override it (Fernet.generate_key()).
TOKEN_ENCRYPTION_KEY=7pLY9C3PlWFCWMtvlkhNSMWreEmwwM-oTidOaU-_dmk=

FRONTEND_BASE_URL=http://localhost:5173

# --- GitHub OAuth App (shared by "Connect GitHub" repo access AND
# "Sign in with GitHub" login, KAN-34 - same App, two redirect URIs since
# they land on two different callback routes - see docs/setup.md) ---
# Use your OWN personal GitHub OAuth App. Never a company-owned one. Add
# BOTH redirect URIs below to the OAuth App's own settings on GitHub.
# Leave blank to keep both integrations disabled (503 on /github/connect
# and /auth/github/login).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
GITHUB_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Shared secret configured on the GitHub webhook itself (see docs/setup.md).
GITHUB_WEBHOOK_SECRET=

# --- Google Drive OAuth Client ("Connect Google Drive" - see docs/setup.md) ---
# Use your OWN personal Google Cloud project. Never a company-owned one.
# Leave blank to keep the integration disabled (503 on /google-drive/connect).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/google-drive/callback

# --- Neo4j (architecture graph store - see docs/adr/0007-architecture-discovery-engine.md) ---
# The defaults below match docker/docker-compose.yml's neo4j service.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphforge-dev

# --- Repository indexer ---
# Where repositories are shallow-cloned to during indexing (always cleaned
# up after each run - see app/indexer/scanner/repository_cloner.py).
INDEXER_CLONE_ROOT=/tmp/graphforge-indexer

# --- AI Provider ---
#
# DATA GOVERNANCE. Every prompt GraphForge sends carries private
# engineering metadata: repository names, file paths, symbol names,
# dependency edges and the user's question. It does NOT send source-code
# bodies, Jira or Confluence content today (those are not retrieved on the
# Ask path at all — see app/services/ask_grounding.py).
#
# Trust is decided from provider type + resolved endpoint + this policy —
# never from the provider's name. app/ai/providers/registry.py classifies
# how each provider is ADDRESSED:
#   customer_account   Bedrock — served in your own cloud account via your
#                      own credential chain; no endpoint to repoint.
#   customer_endpoint  Azure OpenAI, Vertex AI, Ollama — could be yours, but
#                      only the configured endpoint proves it. Trusted when
#                      the endpoint is on a private network, or listed in
#                      APPROVED_AI_ENDPOINTS below. Otherwise blocked.
#   external           OpenAI, Gemini, Groq, DeepSeek, Anthropic, OpenRouter,
#                      Cerebras — a third-party SaaS API under that vendor's
#                      terms. No configuration makes these in-account.
#
# Anything not provably yours fails closed. Set this to true only to
# consciously accept sending the metadata above to a third party.
ALLOW_EXTERNAL_AI_PROVIDERS=false
#
# Endpoint hostnames you have approved as your own infrastructure, for the
# customer_endpoint providers above. Exact hostname match; private/loopback
# addresses need no entry. JSON list, e.g.:
#   APPROVED_AI_ENDPOINTS=["acme-prod.openai.azure.com"]
APPROVED_AI_ENDPOINTS=[]
#
# "openai" (requires billing on your OpenAI account), "groq" (free tier,
# no billing required - get a key at console.groq.com), "deepseek" (get a
# key at platform.deepseek.com), or "gemini" (get a key at
# aistudio.google.com/apikey).
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096

# --- Groq (only used when AI_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- DeepSeek (only used when AI_PROVIDER=deepseek; get a key at
# platform.deepseek.com). DEEPSEEK_BASE_URL is optional - leave blank to use
# the official DeepSeek API; set it to point at a self-hosted or
# third-party OpenAI-compatible DeepSeek endpoint instead. ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=
DEEPSEEK_MAX_TOKENS=16384

# --- Gemini (only used when AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=8192

# --- Future integrations: leave blank until their adapters are implemented ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
AI_ENGINE_API_KEY=
