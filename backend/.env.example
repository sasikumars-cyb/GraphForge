# Copy to .env and adjust for your environment. Never commit the real .env.

APP_NAME=ChangeGuard
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

CORS_ALLOW_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://changeguard:changeguard@localhost:5432/changeguard
DATABASE_ECHO=false

# --- Future integrations: leave blank until their adapters are implemented ---
GITHUB_TOKEN=
JIRA_BASE_URL=
JIRA_API_TOKEN=
NEO4J_URI=
AI_ENGINE_API_KEY=
