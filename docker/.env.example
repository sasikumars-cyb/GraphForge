# Copy to docker/.env and adjust. Never commit the real .env (git-ignored).
#
# This file only holds values docker-compose.yml substitutes into the
# containers via ${VAR} - it is NOT read by the backend app directly (that's
# backend/.env, a separate file - see backend/.env.example). Compose loads
# this automatically because it lives next to docker-compose.yml.

# --- Amazon Bedrock / AWS credentials (see docs/bedrock-setup.md) ---
#
# Preferred: AWS SSO via a named profile. One-time setup on the host:
#   aws configure sso
#   aws sso login --profile my-profile
# Then uncomment the line below and set the profile name -
# docker-compose.yml mounts your host's ~/.aws (read-only) into the backend
# container, so boto3 inside the container sees the same profile config and
# cached SSO token as the host. When the SSO session expires, re-run
# `aws sso login` on the HOST (no `docker compose` restart needed - the
# container reads the live mount).
#
# Leave this commented out (not just blank) if you're not using SSO -
# docker-compose.yml uses bare-name pass-through for this one var
# specifically so an uncommented-but-empty `AWS_PROFILE=` line would still
# get passed into the container and (mostly harmlessly, thanks to
# backend/docker-entrypoint.sh) treated as unset - but commenting it out
# entirely is the clean way to leave it unset.
# AWS_PROFILE=my-profile

# Fallback: explicit temporary credentials (e.g. pasted from the AWS
# Console's "Command line or programmatic access" panel), for developers who
# don't use SSO. Only set these OR AWS_PROFILE, not both - if both are set,
# these explicit keys take precedence and AWS_PROFILE is ignored. These
# expire (usually within hours) and need to be re-pasted when they do -
# AWS_PROFILE above doesn't have this problem.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Defaults to us-east-1 in docker-compose.yml if left unset.
AWS_DEFAULT_REGION=

# --- Production-only (see docker-compose.prod.yml) ---
# POSTGRES_PASSWORD=
# NEO4J_PASSWORD=
# JWT_SECRET_KEY=
# TOKEN_ENCRYPTION_KEY=
